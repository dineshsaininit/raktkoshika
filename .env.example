# Frontend: where the API is. Leave unset for the browser-only demo.
#   http://localhost:4000  API running separately (npm run dev in server/)
#   same-origin            website served by the API server (Render)
VITE_API_URL=http://localhost:4000
# Show sample logins on the sign-in page (set false for real data)
VITE_SHOW_DEMO_LOGINS=true
