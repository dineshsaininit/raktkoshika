# Copy to .env and fill in.
PORT=4000
# Local: mongodb://127.0.0.1:27017/raktkoshika   Atlas: mongodb+srv://user:pass@cluster.x.mongodb.net/raktkoshika
MONGODB_URI=mongodb://127.0.0.1:27017/raktkoshika
# Long random string. Generate with: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=change-me
JWT_EXPIRES_IN=7d
# Comma-separated list of frontend origins allowed to call the API
CORS_ORIGIN=http://localhost:5173
# Demo switches. Turn both off in production.
DEMO_LOGIN=true
ALLOW_DEMO_RESET=true
# Password given to the seeded demo accounts
SEED_PASSWORD=raktkoshika123
