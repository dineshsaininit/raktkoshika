# Copy to .env and fill in. Never commit .env.
PORT=4000

# Neon (or any Postgres) connection string. Tables are created automatically on first start.
DATABASE_URL=postgresql://USER:PASSWORD@HOST/neondb?sslmode=require

# Optional: a separate database for `npm test`, which WIPES the database it uses.
# If unset, tests use the same server with the database name "<name>_test".
# TEST_DATABASE_URL=

# Long random string. Generate with: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=change-me
JWT_EXPIRES_IN=7d

# Frontend addresses allowed to call the API (only needed when the website runs separately, e.g. Vite on 5173)
CORS_ORIGIN=http://localhost:5173

# Loads the sample data on first start when the database is empty
SEED_IF_EMPTY=true
# Lets the admin account restore the sample data. Turn off for real data.
ALLOW_DEMO_RESET=true
# Password-free one-click sign-in. Keep off for anything public.
DEMO_LOGIN=false

# Serve the built website (../dist) from this server. On by default when NODE_ENV=production.
# SERVE_FRONTEND=true

# Keep-alive for Render's free plan. Render sets RENDER_EXTERNAL_URL itself; set this only to override.
# KEEP_ALIVE_URL=https://your-app.onrender.com
KEEP_ALIVE_MINUTES=14
